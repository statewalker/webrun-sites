{
  "name": "@statewalker/webrun-builder",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Incremental, idempotent, resumable build engine: builders over collections with dynamic dependencies, early cut-off, automatic retraction and dead letters; all state in a pluggable ordered KV (memory, FilesApi, SQLite).",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-sites/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-sites/tree/main/packages/webrun-builder#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-sites.git",
    "directory": "packages/webrun-builder"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/webrun-files": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-files-sqlite": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
