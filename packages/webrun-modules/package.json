{
  "name": "@statewalker/webrun-modules",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "Isomorphic module/dependency server: resolve + download + transform npm and authored TS/JS into browser-runnable ESM served from a local FilesApi cache, with no runtime CDN dependency",
  "homepage": "https://github.com/statewalker/webrun-files/tree/main/packages/webrun-modules#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-files.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "lint": "biome check src tests",
    "example": "tsx examples/full-cycle.ts",
    "example:full-cycle": "tsx examples/full-cycle.ts",
    "example:server": "tsx examples/http-server.ts",
    "example:site": "tsx examples/site-pipeline.ts",
    "example:tsx-page": "tsx examples/tsx-page.ts",
    "example:verify": "tsx examples/verify-deps-layout.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "acorn": "catalog:",
    "acorn-globals": "catalog:",
    "sucrase": "catalog:",
    "cjs-module-lexer": "catalog:",
    "resolve.exports": "catalog:",
    "npm-package-arg": "catalog:",
    "semver": "catalog:",
    "@jspm/core": "catalog:",
    "fflate": "catalog:",
    "lightningcss-wasm": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-files-node": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
