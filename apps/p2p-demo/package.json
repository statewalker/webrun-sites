{
  "name": "@statewalker/p2p-demo",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "description": "Merged p2p demo: Node libp2p Circuit Relay v2 + browser server page + browser client page, all bootable from one script.",
  "scripts": {
    "start": "bash scripts/start.sh",
    "relay": "tsx relay/server.ts",
    "server-page": "vite --config vite.server.config.ts --host",
    "client-page": "vite --config vite.client.config.ts --host",
    "build:server-page": "vite build --config vite.server.config.ts",
    "build:client-page": "vite build --config vite.client.config.ts",
    "build": "pnpm run build:server-page && pnpm run build:client-page",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/browser-to-browser.mjs"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "catalog:",
    "@chainsafe/libp2p-yamux": "catalog:",
    "@libp2p/circuit-relay-v2": "catalog:",
    "@libp2p/identify": "catalog:",
    "@libp2p/interface": "catalog:",
    "@libp2p/peer-id": "catalog:",
    "@libp2p/webrtc": "catalog:",
    "@libp2p/websockets": "catalog:",
    "@multiformats/multiaddr": "catalog:",
    "@statewalker/webrun-http-streams": "catalog:",
    "@statewalker/webrun-site-builder": "workspace:*",
    "@statewalker/webrun-site-host": "workspace:*",
    "@statewalker/webrun-streams": "catalog:",
    "@statewalker/webrun-streams-libp2p": "catalog:",
    "libp2p": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-http-browser": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
