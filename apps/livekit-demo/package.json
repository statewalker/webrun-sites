{
  "name": "@statewalker/livekit-demo",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "description": "Cross-app HTTP+SSE demo using LiveKit as the initialisation and transport layer. Mirror of p2p-demo with a LiveKit room replacing the libp2p relay + WebRTC link.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-sites.git",
    "directory": "apps/livekit-demo"
  },
  "bugs": {
    "url": "https://github.com/statewalker/webrun-sites/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-sites/tree/main/apps/livekit-demo#readme",
  "scripts": {
    "start": "bash scripts/start.sh",
    "token-service": "tsx token-service/server.ts",
    "server-page": "vite --config vite.server.config.ts --host",
    "client-page": "vite --config vite.client.config.ts --host",
    "build:server-page": "vite build --config vite.server.config.ts",
    "build:client-page": "vite build --config vite.client.config.ts",
    "build": "pnpm run build:server-page && pnpm run build:client-page",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/webrun-http-streams": "catalog:",
    "@statewalker/webrun-site-builder": "workspace:^",
    "@statewalker/webrun-site-host": "workspace:^",
    "@statewalker/webrun-streams": "catalog:",
    "@statewalker/webrun-streams-livekit": "catalog:",
    "livekit-client": "catalog:",
    "livekit-server-sdk": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-http-browser": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
